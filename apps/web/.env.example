# DeepWrite Web environment variables example
# Copy this file to .env.local for local development.

# Backend gateway base URL (without trailing slash)
VITE_GATEWAY_BASE_URL=http://localhost:8080

# Secret used by client-side cache encryption key derivation.
# NOTE: This is only for partial protection on the client side.
# Do not reuse backend secrets here.
VITE_CACHE_SECRET=change-this-to-a-long-random-string
