APP_NAME: ai-service
APP_ENV: development

DATABASE:
  HOST: localhost
  PORT: 5432
  USER: postgres
  PASSWORD: your_password_here
  NAME: deepwrite
  MIN_POOL_SIZE: 5
  MAX_POOL_SIZE: 20

SERVER:
  HOST: 0.0.0.0
  PORT: 8010
  WORKERS: 1
  DEBUG: true

LOG:
  LEVEL: info
  FORMAT: json

CACHE:
  MODEL_TTL_SECONDS: 300
  QUOTA_TTL_SECONDS: 60

SECURITY:
  INTERNAL_TOKEN: test-internal-token
  API_KEY_ENCRYPTION_KEY: your-32-byte-encryption-key-here